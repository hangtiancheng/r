{
  "name": "resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix ./",
    "format": "prettier -w ./src --experimental-cli",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal public/favicon.svg",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main"
  },
  "dependencies": {
    "@lark.js/mvc": "^0.0.33",
    "@lark.js/sentry": "latest",
    "@swifty.js/anti-copy": "latest",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "pnpm": {
    "overrides": {
      "@swifty.js/sentry": "latest"
    }
  }
}
