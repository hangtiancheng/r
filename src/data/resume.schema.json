{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume.schema.json",
  "title": "ResumeDoc",
  "description": "Resume document structure, mirroring ResumeDoc in src/lib/types.ts. Describes both the single document persisted in IndexedDB and the backup file format used by \"download resume JSON / import resume JSON\" (src/data/default-resume.json is one instance).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "base",
    "edu",
    "works",
    "projects",
    "honors",
    "customModules",
    "hiddenModules",
    "updatedAt"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional reference to this schema, for editor tooling only; ignored on import."
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Fixed document id in the single-document store."
    },
    "title": {
      "type": "string",
      "description": "Resume title; also used as the export file name."
    },
    "base": {
      "$ref": "#/$defs/BaseInfo"
    },
    "edu": {
      "type": "array",
      "description": "Education entries.",
      "items": { "$ref": "#/$defs/EduItem" }
    },
    "works": {
      "type": "array",
      "description": "Work experience entries.",
      "items": { "$ref": "#/$defs/WorkItem" }
    },
    "projects": {
      "type": "array",
      "description": "Project entries.",
      "items": { "$ref": "#/$defs/ProjectItem" }
    },
    "honors": {
      "type": "array",
      "description": "Honors and awards entries.",
      "items": { "$ref": "#/$defs/HonorItem" }
    },
    "customModules": {
      "type": "array",
      "description": "Custom module entries. Each module consists of a title, an icon, and Markdown body content.",
      "items": { "$ref": "#/$defs/CustomModule" }
    },
    "hiddenModules": {
      "type": "array",
      "description": "Built-in modules hidden on the paper. Hiding does not delete data; it only affects rendering. Custom modules use their own hidden field.",
      "items": { "$ref": "#/$defs/ModuleKind" }
    },
    "updatedAt": {
      "type": "number",
      "description": "Timestamp of the last save (Date.now() milliseconds)."
    }
  },
  "$defs": {
    "ModuleKind": {
      "type": "string",
      "description": "Identifier of a built-in resume module.",
      "enum": ["base", "edu", "work", "project", "honor"]
    },
    "Gender": {
      "type": "string",
      "enum": ["男", "女"]
    },
    "BirthDisplay": {
      "type": "string",
      "description": "How birth information is presented on the paper.",
      "enum": ["age", "month"]
    },
    "Month": {
      "type": "string",
      "description": "Month in \"YYYY-MM\" format; an empty string means not provided.",
      "pattern": "^(\\d{4}-(0[1-9]|1[0-2]))?$"
    },
    "BaseInfo": {
      "type": "object",
      "description": "Personal information module.",
      "additionalProperties": false,
      "required": [
        "name",
        "gender",
        "birth",
        "birthDisplay",
        "freshGraduate",
        "workStart",
        "tel",
        "email",
        "hometown",
        "location",
        "degree"
      ],
      "properties": {
        "name": { "type": "string", "description": "Full name." },
        "gender": { "$ref": "#/$defs/Gender" },
        "birth": {
          "$ref": "#/$defs/Month",
          "description": "Birth month; rendered as age or birth month according to birthDisplay."
        },
        "birthDisplay": {
          "$ref": "#/$defs/BirthDisplay",
          "description": "age renders the computed age; month renders the birth month."
        },
        "freshGraduate": {
          "type": "boolean",
          "description": "Fresh graduate badge."
        },
        "workStart": {
          "$ref": "#/$defs/Month",
          "description": "First employment start date (optional)."
        },
        "tel": { "type": "string", "description": "Mobile phone number." },
        "email": { "type": "string", "description": "Email address." },
        "hometown": {
          "type": "string",
          "description": "Hometown / place of origin."
        },
        "location": { "type": "string", "description": "Current location." },
        "degree": {
          "type": "string",
          "description": "Highest degree attained."
        }
      }
    },
    "EduItem": {
      "type": "object",
      "description": "A single education entry.",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "ongoing",
        "school",
        "major",
        "degree",
        "gpa",
        "rank"
      ],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "start": { "$ref": "#/$defs/Month" },
        "end": { "$ref": "#/$defs/Month" },
        "ongoing": {
          "type": "boolean",
          "description": "Whether the program is in progress (rendered as \"Present\")."
        },
        "school": { "type": "string", "description": "School / institution." },
        "major": { "type": "string", "description": "Major / field of study." },
        "degree": { "type": "string", "description": "Degree level." },
        "gpa": { "type": "string", "description": "GPA (optional)." },
        "rank": {
          "type": "string",
          "description": "Academic ranking (optional)."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hidden entries retain their data and are simply skipped on the paper."
        }
      }
    },
    "WorkDetail": {
      "type": "object",
      "description": "A work-content segment within a work experience entry.",
      "additionalProperties": false,
      "required": ["id", "title", "content"],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "title": { "type": "string", "description": "Segment subtitle." },
        "content": {
          "type": "string",
          "description": "Markdown body (e.g. a bulleted list)."
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "description": "A single work experience entry.",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "ongoing",
        "company",
        "department",
        "position",
        "details"
      ],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "start": { "$ref": "#/$defs/Month" },
        "end": { "$ref": "#/$defs/Month" },
        "ongoing": {
          "type": "boolean",
          "description": "Whether currently employed (rendered as \"Present\")."
        },
        "company": { "type": "string", "description": "Company name." },
        "department": { "type": "string", "description": "Department." },
        "position": {
          "type": "string",
          "description": "Position / job title."
        },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/WorkDetail" }
        },
        "hidden": {
          "type": "boolean",
          "description": "Hidden entries retain their data and are simply skipped on the paper."
        }
      }
    },
    "ProjectItem": {
      "type": "object",
      "description": "A single project entry.",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end",
        "ongoing",
        "name",
        "duty",
        "repo",
        "content"
      ],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "start": { "$ref": "#/$defs/Month" },
        "end": { "$ref": "#/$defs/Month" },
        "ongoing": {
          "type": "boolean",
          "description": "Whether the project is in progress (rendered as \"Present\")."
        },
        "name": { "type": "string", "description": "Project name." },
        "duty": {
          "type": "string",
          "description": "Role held in the project."
        },
        "repo": {
          "type": "string",
          "description": "Repository / link (optional)."
        },
        "content": {
          "type": "string",
          "description": "Markdown body (e.g. a bulleted list)."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hidden entries retain their data and are simply skipped on the paper."
        }
      }
    },
    "HonorItem": {
      "type": "object",
      "description": "A single honors-and-awards entry.",
      "additionalProperties": false,
      "required": ["id", "name", "issuer", "date"],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "name": { "type": "string", "description": "Award / honor name." },
        "issuer": { "type": "string", "description": "Issuing organization." },
        "date": {
          "$ref": "#/$defs/Month",
          "description": "Date the award was received."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hidden entries retain their data and are simply skipped on the paper."
        }
      }
    },
    "CustomModule": {
      "type": "object",
      "description": "A single custom module.",
      "additionalProperties": false,
      "required": ["id", "name", "icon", "content"],
      "properties": {
        "id": { "type": "string", "description": "Unique entry id." },
        "name": { "type": "string", "description": "Module title." },
        "icon": {
          "type": "string",
          "description": "Module icon, keyed by lucide-react icon name (see the deduped registry built in src/lib/icons-registry.ts)."
        },
        "content": {
          "type": "string",
          "description": "Markdown body."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hidden entries retain their data and are simply skipped on the paper."
        }
      }
    }
  }
}
